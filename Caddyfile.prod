# Served behind Cloudflare Tunnel: plain HTTP on :80, no TLS here.
# Cloudflare terminates TLS at the edge; cloudflared reaches this container
# over the private `edge` docker network. www -> apex redirect is a Cloudflare rule.
:80 {
    handle /uploads/* {
        root * /srv
        @uploadFile file
        handle @uploadFile {
            file_server
        }
        # File missing on disk — let Next.js try the -original.{ext} fallback
        handle {
            rewrite * /api/img-fallback{uri}
            reverse_proxy app:3000
        }
    }

    handle {
        reverse_proxy app:3000
    }
}
